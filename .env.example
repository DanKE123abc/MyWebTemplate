# 数据库是可选项：不使用数据库的子项目可保持以下配置为空。
# Node / Next.js：可用 pg 或 mysql；DATABASE_URL 也可单独设置（自动识别协议）。
# Cloudflare Workers / Vinext：使用 D1，绑定在 wrangler.jsonc 中配置；无需 DATABASE_URL。

# DATABASE_PROVIDER=pg
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app

# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/app

# DATABASE_PROVIDER=d1

# DK1：共享物理 D1 上的虚拟数据库（推荐 Workers 使用 DK1_SERVICE 绑定）
# 本地 Next dev 用统一入口；Workers 可用 Service Binding，无需 DK1_URL。
# DATABASE_PROVIDER=dk1
# DK1_URL=http://127.0.0.1:3000
# DK1_APP_ID=app_xxxxxxxx
# DK1_API_KEY=dk1_xxxxxxxx
# DK1_TIMEOUT_MS=10000
